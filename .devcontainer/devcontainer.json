{
  "name": "Color Grid Puzzle",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-24-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/java:1": {
      "version": "21",
      "installGradle": true
    }
  },
  "forwardPorts": [5173, 4173],
  "portsAttributes": {
    "5173": { "label": "Color Grid web game", "onAutoForward": "openBrowser" },
    "4173": { "label": "Color Grid preview", "onAutoForward": "openBrowser" }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "vscjava.vscode-java-pack",
        "github.vscode-github-actions"
      ]
    }
  },
  "postCreateCommand": "npm ci"
}